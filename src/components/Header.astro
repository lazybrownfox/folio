---
const anchors = [
  { id: "#cases", label: "Cases" },
  { id: "#craft", label: "Motion" },
  { id: "#systems", label: "Systems" },
  { id: "#brand", label: "Brand" },
  { id: "#work", label: "Work" },
  { id: "#contact", label: "Contact" },
];
---
<header
  class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-4 px-5 py-3 sm:px-8"
>
  <a href="#top" class="group flex items-baseline" aria-label="Back to top">
    <span class="font-display text-xl text-fg">fhd</span>
    <span class="font-display text-xl italic text-accent">.</span>
  </a>

  <nav
    data-anchors
    aria-label="Sections"
    class="pointer-events-auto hidden items-center gap-6 md:flex"
  >
    {
      anchors.map((a) => (
        <a
          href={a.id}
          data-nav-label={a.label}
          class="text-sm font-semibold text-muted transition-colors hover:text-fg"
        >
          {a.label}
        </a>
      ))
    }
  </nav>

  <script is:inline>
    document.querySelectorAll('[data-nav-label]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture('nav_section_clicked', {
          section: link.dataset.navLabel,
          href: link.getAttribute('href'),
        });
      });
    });
  </script>
</header>
