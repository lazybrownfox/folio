---
// Bracketed annotation callout — the Readymag-inspired motif.
// A floating [ LABEL ] that points at content. Recurring brand device used to
// annotate metrics (KB/ms), decisions and angles. Reveals via GSAP; in Story
// mode buildStoryScenes() sequences these for the cinematic read.
interface Props {
  text: string;
  class?: string; // positioning utilities (e.g. "absolute right-[8%] top-[20%]")
  delay?: number;
  accent?: boolean; // accent-colored text instead of muted
  line?: boolean; // leading connector line (Story-only, drawn by buildStoryScenes)
}
const { text, class: cls = "", delay = 0, accent = false, line = false } = Astro.props;
---
<span
  data-reveal
  data-reveal-delay={delay}
  data-bracket
  class={`bracket ${cls}`}
>
  {line && <span class="bracket-conn" data-connector></span>}
  <span class="bracket-mark">[</span>
  <span class={accent ? "bracket-text bracket-accent" : "bracket-text"}>{text}</span>
  <span class="bracket-mark">]</span>
</span>

<style>
  .bracket {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    user-select: none;
  }
  .bracket-mark {
    color: var(--color-accent);
    font-size: 1.5em;
    line-height: 0;
    font-weight: 400;
    transform: translateY(0.04em);
  }
  .bracket-text {
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .bracket-accent {
    color: var(--color-accent);
  }
  .bracket-conn {
    display: inline-block;
    width: 2.25rem;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.55;
    transform-origin: left center;
  }
</style>
