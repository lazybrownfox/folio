---
import type { WorkImage } from "../data/works";

interface Props {
  image: WorkImage;
  /** Fallbacks inherited from the project when the image doesn't set them. */
  fit?: "cover" | "contain";
  bg?: string;
  /** The hero plate runs a touch taller. */
  size?: "hero" | "block";
  eager?: boolean;
}

const { image, fit, bg, size = "block", eager = false } = Astro.props;

const contain = (image.fit ?? fit) === "contain";
const ground = image.bg ?? bg;
const stageStyle = [
  ground ? `background:${ground}` : "",
  image.video && image.videoAspect ? `--va:${image.videoAspect}` : "",
]
  .filter(Boolean)
  .join(";");
---

<figure class:list={["case-figure", size === "hero" && "is-hero"]}>
  <div
    class:list={["case-stage", contain && "is-contain", image.video && "is-video"]}
    style={stageStyle}
    data-fullscreen={image.video ? "" : undefined}
    role={image.video ? "button" : undefined}
    tabindex={image.video ? 0 : undefined}
    aria-label={image.video ? `Play fullscreen — ${image.alt}` : undefined}
  >
    {
      image.video ? (
        <>
          {/* No native controls: these clips are rendered inside a phone
              mock-up, and a browser control bar painted across the device
              screen breaks the illusion it exists to sell. Same
              click-to-fullscreen affordance as the motion grid on the home. */}
          <video
            data-motion
            class="pointer-events-none"
            src={image.video}
            poster={image.src}
            preload="metadata"
            muted
            loop
            playsinline
            aria-label={image.alt}
          />
          <span class="case-stage-fs" aria-hidden="true">
            ⤢
          </span>
        </>
      ) : (
        <img
          src={image.src}
          alt={image.alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          style={image.position ? `object-position:${image.position}` : undefined}
        />
      )
    }
  </div>
  {image.caption && <figcaption class="case-caption">{image.caption}</figcaption>}
</figure>
