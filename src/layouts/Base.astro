---
import "../styles/global.css";
import Header from "../components/Header.astro";
import PostHog from "../components/posthog.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "François-Henri Dupuich — Product Designer",
  description = "Product designer for early teams and complex products. I turn ambiguity into interface systems, design ops and shippable product work.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="story">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Do not index, do not train. Reinforced by robots.txt + X-Robots-Tag. -->
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
    />
    <meta name="googlebot" content="noindex, nofollow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts (subset/self-host in the M6 perf pass) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!-- General Sans (Fontshare) — the display voice, everywhere --font-display is used -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700,800&display=swap" />

    <PostHog />

    <!-- Anti-FOUC: set mode + theme and arm reveals before first paint. -->
    <script is:inline>
      (function () {
        try {
          var d = document.documentElement;
          var m = localStorage.getItem("folio-mode");
          var r = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          d.dataset.mode = m || (r ? "libre" : "story");

          // Theme: ?theme=light|dark wins (and sticks, so it survives a jump
          // to a case-study page), then whatever was last toggled. Dark is
          // still the default art direction.
          var t = null;
          try {
            t = new URLSearchParams(location.search).get("theme");
          } catch (e) {}
          if (t === "light" || t === "dark") {
            localStorage.setItem("folio-theme", t);
          } else {
            t = localStorage.getItem("folio-theme");
          }
          d.dataset.theme = t === "light" ? "light" : "dark";

          // A successful password check leaves a one-navigation flag. The
          // destination consumes it before first paint so the private gate and
          // the portfolio feel like one continuous transition.
          try {
            if (sessionStorage.getItem("folio-entry") === "1") {
              sessionStorage.removeItem("folio-entry");
              if (!r) d.classList.add("from-login");
            }
          } catch (e) {}

          d.classList.add("js");
          if (!r) {
            d.classList.add("armed");
            // failsafe: if the bundle never boots (no `reveal-ready`), reveal
            // everything so content is never stranded hidden. When the bundle
            // does run, ScrollTrigger handles reveals and this no-ops (no jank).
            setTimeout(function () {
              if (!d.classList.contains("reveal-ready")) {
                d.classList.add("reveal-all");
              }
            }, 2500);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <div class="entry-curtain" aria-hidden="true">
      <span><i></i>fhd.xyz</span>
    </div>

    <a
      href="#top"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-bg"
      >Skip to content</a
    >

    <Header />

    <main id="top">
      <slot />
    </main>

    <Analytics />
    <SpeedInsights />

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
