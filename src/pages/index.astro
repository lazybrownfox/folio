---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import NetContributionsChart from "../components/dataviz/NetContributionsChart.tsx";
import ProjectionDataviz from "../components/dataviz/ProjectionChart.tsx";
import MotionGrid from "../components/MotionGrid.astro";
import AlbaShowcase from "../components/AlbaShowcase.tsx";
import WorkGallery from "../components/WorkGallery.tsx";
import SncfBoard from "../components/SncfBoard.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import ApproachLedger from "../components/ApproachLedger.astro";

const heroTags = [
  "+10 yrs",
  "design systems",
  "branding",
  "dataviz",
  "motion",
];

// Profile statement — revealed word by word as you scroll (see buildStatement
// in site.ts). Kept as one string so the markup can split it into spans.
const statement =
  "Ten-year product designer for SaaS, fintech and dev tools — based in Paris. I work through the interface, the design system beneath it and the code that ships it, so dense products end up feeling simple.";

// `slug` is set only where a case-study page exists; the others are stills.
const brand = [
  { img: "blacksails", name: "Black Sales", tag: "brand · product", scale: 1.22 },
  { img: "ple-cover", name: "Plé", tag: "audio identity", scale: 1.0, slug: "ple" },
  { img: "plume-cover", name: "Plume", tag: "mobility identity", scale: 1.0, slug: "plume" },
  { img: "beroe", name: "beroé", tag: "brand", scale: 1.12 },
];
---

<Base>
  <!-- 00 · HERO -------------------------------------------------------------->
  <section
    id="hero"
    class="relative flex min-h-[100svh] flex-col justify-center px-5 pt-24 sm:px-8"
  >
    <div class="relative mx-auto w-full max-w-6xl">
      <p data-reveal class="kicker mb-6">
        Founding designer · Paris
      </p>

      <h1
        data-reveal
        data-reveal-delay="0.05"
        class="font-display max-w-5xl font-normal leading-[1.03] tracking-[-0.015em] text-balance"
        style="font-size: var(--text-display)"
      >
        Design that makes complexity <em class="text-accent">disappear</em>.
      </h1>

      <p
        data-reveal
        data-reveal-delay="0.1"
        class="mt-8 max-w-2xl text-lg text-muted sm:text-xl"
      >
        I’m François-Henri Dupuich, product designer in Paris. Ten years turning
        dense subjects — wealth, rail, data — into things people simply
        understand.
      </p>

      <p data-reveal data-reveal-delay="0.15" class="mt-10 font-mono text-[0.68rem] tracking-[0.05em] text-faint uppercase">
        <span class="mr-2 inline-block h-[5px] w-[5px] rounded-full bg-accent align-[2px]"></span>{heroTags.join(" · ")}
      </p>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-6 mx-auto w-full max-w-6xl px-5 sm:px-8"
    >
      <span class="tag">scroll ↓</span>
    </div>
  </section>

  <!-- 01 · PROFILE (statement + skills) --------------------------------------->
  <section
    id="manifesto"
    class="relative scroll-mt-20 border-t border-line px-5 py-24 sm:px-8 sm:py-32"
  >
    <div class="mx-auto w-full max-w-6xl">
      <div data-reveal class="mb-10 flex items-baseline justify-between gap-4">
        <span class="kicker">Profile</span>
        <span class="font-mono text-[0.62rem] text-faint">01</span>
      </div>

      <p class="statement max-w-4xl" data-statement>
        {statement.split(" ").map((w) => <span class="st-w">{w}&#32;</span>)}
      </p>

      <div class="mt-16 sm:mt-20">
        <SkillsGrid />
      </div>
    </div>
  </section>

  <!-- 02 · CASE DECK (live) ---------------------------------------------------->
  <section
    id="cases"
    class="relative scroll-mt-20 border-t border-line px-5 py-24 sm:px-8 sm:py-32"
  >
    <div class="mx-auto w-full max-w-6xl">
      <div data-reveal class="mb-10 flex items-baseline justify-between gap-4">
        <span class="kicker">Case studies · live</span>
        <span class="font-mono text-[0.62rem] text-faint">02</span>
      </div>

      <div class="case-deck">
        <article class="case-card case-nalo" id="dataviz">
          <div class="case-head">
            <span>Nalo · 2023–26</span>
            <span>Fintech · Dataviz</span>
          </div>
          <h3 class="deck-title">Money, made readable.<i>live chart</i></h3>
          <p class="deck-lede">
            This chart splits a balance into net invested capital and gains —
            and makes a counter-intuitive case visible: invested capital can go
            negative while the balance stays positive. Switch scenarios, hover
            any point.
          </p>
          <div class="case-plate">
            <NetContributionsChart client:visible />
            <p class="tag mt-3 text-[0.64rem] text-faint">
              recharts · rendered live in your browser
            </p>
          </div>
        </article>

        <article class="case-card case-nalo2">
          <div class="case-head">
            <span>Nalo · 2023–26</span>
            <span>Fintech · Projection</span>
          </div>
          <h3 class="deck-title">Twenty-five years, one glance.<i>live chart</i></h3>
          <p class="deck-lede">
            A long-horizon projection with a progressive-derisking path. Toggle
            the strategy: the probability cone, IRR cards and risk score
            respond in real time.
          </p>
          <div class="case-plate">
            <ProjectionDataviz client:visible />
          </div>
        </article>

        <article class="case-card case-sncf" id="track">
          <div class="case-head">
            <span>SNCF · 2019–22</span>
            <span>Rail · Technical UI</span>
          </div>
          <h3 class="deck-title">Legibility is the product.<i>live board</i></h3>
          <p class="deck-lede">
            Real-time passenger displays designed around hierarchy, distance
            and stress. Not a screenshot — a live rebuild of the departures
            board: statuses, platforms and the clock run on their own.
          </p>
          <div class="mt-6">
            <SncfBoard />
          </div>
          <p class="case-note">live · recreated in the browser · split-flap included</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 · OPTIMISATION / CRAFT ---------------------------------------------->
  <Section
    id="craft"
    index="03"
    kicker="Motion design · in code"
    title="Product motion built in code."
  >
    <p data-reveal class="mb-10 max-w-2xl text-lg text-muted">
      Motion inserts for an investment app release: interface states,
      transitions and <span class="text-fg">live charts built with Recharts</span>.
      They were authored in React and Remotion, the same language as the
      product, then exported here as video.
    </p>

    <div data-reveal>
      <MotionGrid />
    </div>
  </Section>

  <!-- 04 · SYSTEMS (DS + ops) ------------------------------------------------>
  <Section
    id="systems"
    index="04"
    kicker="Design systems & ops"
    title="Design systems for the interface and the way teams work."
  >
    <div class="grid gap-10 md:grid-cols-2">
      <div data-reveal>
        <h3 class="mb-3 font-semibold">Interface system</h3>
        <p class="text-muted">
          Tokens, variants, naming and documentation: a design system treated
          as a product, not a folder of components.
        </p>
      </div>
      <div data-reveal data-reveal-delay="0.05">
        <h3 class="mb-3 font-semibold">Team system</h3>
        <p class="text-muted">
          Design ops for handoff, tooling, rituals and quality checks: the
          habits that make design usable inside product cycles.
        </p>
      </div>
    </div>

    <div data-reveal class="mt-14">
      <AlbaShowcase client:visible />
    </div>
  </Section>

  <!-- 05 · BRAND ------------------------------------------------------------->
  <Section
    id="brand"
    index="05"
    kicker="Branding & identities"
    title="Identities for products, brands and tech tools."
  >
    <p data-reveal class="mb-8 max-w-2xl text-lg text-muted">
      Brand and art direction across product identities, open-source tooling and
      community projects. The work spans polished launches and small technical
      ecosystems, with a feel for how developer culture should look and sound.
    </p>
    <div
      data-reveal
      class="grid grid-cols-2 gap-3 sm:grid-cols-4"
    >
      {
        brand.map((b) => {
          const Tile = b.slug ? "a" : "div";
          return (
          <Tile
            href={b.slug ? `/work/${b.slug}` : undefined}
            aria-label={b.slug ? `Read the ${b.name} case study` : undefined}
            class:list={[
              "group relative block aspect-[3/4] overflow-hidden rounded-lg border border-line bg-bg-elev/40 text-left transition-colors",
              b.slug && "cursor-pointer hover:border-line-strong",
            ]}
          >
            <img
              src={`/work/${b.img}.jpg`}
              alt={b.name}
              loading="lazy"
              decoding="async"
              width="595"
              height="842"
              style={`transform: scale(${b.scale}); transform-origin: center; object-position: center`}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent" />
            {/* sits on the black gradient, so it stays light in both themes */}
            <figcaption class="brand-cap absolute inset-x-0 bottom-0 flex flex-col p-3">
              <span class="text-sm">{b.name}</span>
              <span class="tag mt-1">{b.tag}</span>
            </figcaption>
          </Tile>
          );
        })
      }
    </div>
    <p data-reveal class="mt-6 max-w-2xl text-sm text-faint">
      Also: legacy marks for Snatch &amp; Zou (Rust CLI download tools),
      multilayer-perceptron (Erlang), and PluXML community templates.
    </p>
  </Section>

  <!-- 06 · SELECTED WORK ----------------------------------------------------->
  <Section
    id="work"
    index="06"
    kicker="Selected work"
    title="Selected work."
  >
    <p data-reveal class="mb-8 max-w-2xl text-lg text-muted">
      Ten years across product, design systems, brand and open source. Hover a
      name and its world takes the screen; the ones marked <span class="text-fg"
        >read</span
      > open a case study. The rest are available on request.
    </p>
    <div data-reveal>
      <WorkGallery client:load />
    </div>
  </Section>

  <!-- 07 · APPROACH (AI-native practice) -------------------------------------->
  <Section
    id="approach"
    index="07"
    kicker="Approach · AI-native"
    title="Designing with agents, not around them."
  >
    <p data-reveal class="mb-4 max-w-2xl text-lg text-muted">
      The work above was made in a practice where agents handle the mechanical
      half — driving Figma, crawling live apps, wiring prototypes, reading the
      logs — while <span class="text-fg">the judgement stays mine</span>. It
      isn’t a side experiment. It’s how the days actually run, and it leaves a
      trace I can count.
    </p>

    <div class="mt-12">
      <ApproachLedger />
    </div>

    <div class="mt-16 grid gap-3 sm:grid-cols-2">
      <article data-reveal class="approach-card">
        <h3 class="approach-name">Design → code, both ways</h3>
        <p class="approach-desc">
          A live app gets crawled, rebuilt in Figma with the design system
          already applied, then pushed back out as tokens. The round trip takes
          an afternoon instead of a sprint.
        </p>
      </article>
      <article data-reveal data-reveal-delay="0.05" class="approach-card">
        <h3 class="approach-name">Systems work at scale</h3>
        <p class="approach-desc">
          Auditing thousands of colour fills across a library, re-mapping them
          onto semantic tokens, generating component documentation page after
          page — the parts that used to be too expensive to do properly.
        </p>
      </article>
      <article data-reveal data-reveal-delay="0.1" class="approach-card">
        <h3 class="approach-name">Prototypes that settle arguments</h3>
        <p class="approach-desc">
          When a product debate stalls on a hypothesis, I build the thing and we
          look at it. The charts higher up this page started as exactly that.
        </p>
      </article>
      <article data-reveal data-reveal-delay="0.15" class="approach-card">
        <h3 class="approach-name">Research, compressed</h3>
        <p class="approach-desc">
          Hundreds of user verbatims clustered, tagged and turned into a report
          in a day — so the qualitative signal actually reaches the design
          instead of dying in a spreadsheet.
        </p>
      </article>
    </div>

    <aside data-reveal class="approach-caveat">
      <span class="approach-caveat-label">What this doesn’t prove</span>
      <p>
        I haven’t shipped an AI feature to end users. These numbers describe how
        I work, not a claim to have built someone’s model into a product. Read
        them as craft, not credentials.
      </p>
    </aside>
  </Section>

  <!-- 08 · CONTACT ----------------------------------------------------------->
  <Section
    id="contact"
    index="08"
    kicker="Contact"
    title="Need a founding designer with range?"
  >
    <p data-reveal class="mb-8 max-w-2xl text-lg text-muted">
      Looking for a founding or first designer who can own the product surface,
      the system beneath it and the shipping rhythm around it? Let’s talk.
    </p>
    <div data-reveal class="flex flex-wrap gap-4">
      <a
        href="mailto:francoishenri.dupuich@gmail.com"
        id="contact-email-link"
        class="rounded-full bg-fg px-6 py-3 text-sm font-semibold text-bg transition-colors hover:bg-accent"
      >
        francoishenri.dupuich@gmail.com
      </a>
    </div>
  </Section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Contact email click — primary conversion
      document.getElementById('contact-email-link')?.addEventListener('click', function () {
        window.posthog?.capture('contact_email_clicked');
      });

      // Contact section viewed — top of conversion funnel
      var contactSection = document.querySelector('#contact');
      if (contactSection) {
        var contactObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              window.posthog?.capture('contact_section_viewed');
              contactObserver.disconnect();
            }
          });
        }, { threshold: 0.3 });
        contactObserver.observe(contactSection);
      }
    });
  </script>

  <footer class="border-t border-line px-5 py-10 sm:px-8">
    <div
      class="mx-auto flex w-full max-w-6xl items-center justify-between text-faint"
    >
      <span class="text-sm text-muted">© 2026 François-Henri Dupuich</span>
      <span class="tag text-[0.64rem] text-faint">built lean with astro + gsap</span>
    </div>
  </footer>
</Base>
